DEBUG_EXTRACTION=false
HTTP_TIMEOUT_SECONDS=20
MAX_REDIRECTS=10

# MySQL connection settings (used by the FastAPI cache layer)
MYSQL_HOST=192.168.1.25
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=qlikbiz
MYSQL_CHARSET=utf8mb4

CACHE_TTL_HOURS=168
MAX_CONCURRENT_REQUESTS=10
RETRY_ATTEMPTS=3
API_KEY=your_secret_api_key_here
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BULK_URLS=100

# PHP-side environment variables (set in your PHP server / .htaccess / docker-compose)
